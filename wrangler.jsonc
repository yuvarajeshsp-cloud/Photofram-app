{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public Photofram site (Astro, server output). The admin is a separate
  // Worker in admin/ that shares the same D1 database and R2 buckets.
  "name": "photofram",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photofram",
      "database_id": "d5884e8a-b9c1-4e95-9a6d-54184e58db61",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "photofram-media" },
    { "binding": "AR", "bucket_name": "photofram-ar" }
  ],
  "vars": {
    // Address of the admin Worker; /admin on the public site redirects there.
    "ADMIN_URL": "https://photofram-admin.photofram-web.workers.dev"
  }
}
