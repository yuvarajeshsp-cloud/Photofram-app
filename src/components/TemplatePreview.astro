---
// A frame template drawn as SVG with sample photos in its slots and the
// chosen finish as moulding. Same slot geometry as the customizer, so what
// the catalog shows is what the customizer builds.
import type { FrameTemplate } from '../lib/templates';
import { FONT_STACKS, slotPath } from '../lib/templates';
import { samplePhoto } from '../lib/samplePhotos';

interface Props {
  template: FrameTemplate;
  /** Moulding colour; defaults to the template's first framed finish. */
  finish?: string | null;
  class?: string;
}
const { template: t, class: className } = Astro.props;
const finish = Astro.props.finish !== undefined ? Astro.props.finish : (t.finishes.find((f) => f.color)?.color ?? null);

const W = t.aspect.w * 200;
const H = t.aspect.h * 200;
const b = finish ? Math.round(Math.min(W, H) * 0.065) : 0;
const m = finish ? Math.round(b * 0.7) : 0;
const pad = b + m;
const TW = W + 2 * pad;
const TH = H + 2 * pad;
const uid = `tp-${t.slug}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg class:list={['frame-art', className]} viewBox={`0 0 ${TW} ${TH}`} role="img" aria-label={`${t.name} with sample photos`}>
  <defs>
    {t.slots.map((s, i) => (
      <clipPath id={`${uid}-${i}`}>
        <path d={slotPath(s.shape, pad + s.x * W, pad + s.y * H, s.w * W, s.h * H)} />
      </clipPath>
    ))}
  </defs>
  {finish ? (
    <>
      <rect width={TW} height={TH} fill={finish} />
      <path d={`M0 0 L${b} ${b} L${TW - b} ${b} L${TW} 0Z`} fill="#fff" opacity="0.14" />
      <path d={`M0 ${TH} L${b} ${TH - b} L${TW - b} ${TH - b} L${TW} ${TH}Z`} fill="#000" opacity="0.2" />
      <rect x={b} y={b} width={W + 2 * m} height={H + 2 * m} fill="#fbfbf9" />
    </>
  ) : (
    <rect width={TW} height={TH} fill="#fbfbf9" />
  )}
  <rect x={pad} y={pad} width={W} height={H} fill={t.background} />
  {t.slots.map((s, i) => (
    <image
      href={samplePhoto(i)}
      x={pad + s.x * W}
      y={pad + s.y * H}
      width={s.w * W}
      height={s.h * H}
      preserveAspectRatio="xMidYMid slice"
      clip-path={`url(#${uid}-${i})`}
    />
  ))}
  {t.texts.map((txt) => (
    <text
      x={pad + (txt.align === 'left' ? (txt.x - txt.w / 2) * W : txt.x * W)}
      y={pad + txt.y * H}
      text-anchor={txt.align === 'left' ? 'start' : 'middle'}
      dominant-baseline="middle"
      font-size={txt.size * H}
      fill={txt.color}
      font-family={FONT_STACKS[txt.font]}
    >
      {txt.placeholder}
    </text>
  ))}
</svg>
