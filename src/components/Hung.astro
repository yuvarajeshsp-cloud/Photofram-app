---
// A frame hung on a wall: nail, picture wire and a soft offset shadow.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['hung', className]}>
  <span class="hung__nail" aria-hidden="true"></span>
  <svg class="hung__string" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
    <path d="M50 1 L2 34 M50 1 L98 34" stroke="#3a3a38" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
  </svg>
  <slot />
</div>
