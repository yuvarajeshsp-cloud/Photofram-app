---
import type { FrameTemplate } from '../lib/templates';
import { formatINR, priceRange } from '../lib/templates';
import TemplatePreview from './TemplatePreview.astro';
import Hung from './Hung.astro';

interface Props {
  template: FrameTemplate;
}
const { template: t } = Astro.props;
const range = priceRange(t);
const landscape = t.aspect.w > t.aspect.h;
---

<a class="tcard" href={`/frames/${t.slug}`} data-stat-view={t.slug}>
  {t.preview ? (
    <img class="tcard__img" src={t.preview} alt={t.name} loading="lazy" />
  ) : (
    <div class:list={['tcard__wall', 'wall', { 'is-landscape': landscape }]}>
      <Hung><TemplatePreview template={t} /></Hung>
    </div>
  )}
  <div>
    <div class="tcard__name">{t.name}</div>
    <div class="tcard__meta">{t.slots.length} photo{t.slots.length > 1 ? 's' : ''} · {t.category}</div>
    <div class="tcard__price">From {formatINR(range.min)}</div>
  </div>
</a>
