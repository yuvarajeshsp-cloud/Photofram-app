---
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import WallChips from '../../components/WallChips.astro';
import { content } from '../../lib/content';

const categories = [...new Set(content.templates.map((t) => t.category))];
---

<Base title="Frame Layouts" description="All personalised photo frame layouts: collages, heart frames and single photo frames, shown on your wall.">
  <section class="container page-head">
    <h1>Frame layouts</h1>
    <p class="section__intro" style="margin-bottom:20px">
      Every layout has its photo spots set by us; you add the photos and words. Prices include the frame. Shipping is free above ₹{content.settings.shipping.free_above}.
    </p>
    <WallChips />
  </section>
  {categories.map((cat) => (
    <section class="container" style="padding-top:40px">
      <h2>{cat}</h2>
      <div class="tgrid" style="margin-top:18px">
        {content.templates.filter((t) => t.category === cat).map((t) => <TemplateCard template={t} />)}
      </div>
    </section>
  ))}
  <div class="container"><p class="sample-note" style="margin:16px 0 0">Previews use sample photos; yours replace them in the editor.</p>
  </div>
  <div style="height:64px"></div>
</Base>
