---
import Base from '../../layouts/Base.astro';
import FrameCustomizer from '../../components/customizer/FrameCustomizer';
import { content } from '../../lib/content';
import { site } from '../../config/site';
import { formatINR, priceRange } from '../../lib/templates';

export function getStaticPaths() {
  return content.templates.map((t) => ({ params: { slug: t.slug }, props: { template: t } }));
}

const { template: t } = Astro.props;
const range = priceRange(t);
---

<Base title={t.name} description={`${t.description} From ${formatINR(range.min)}. Add your photos, preview live and see it on your wall.`}>
  <section class="container" style="padding-top:28px;padding-bottom:56px">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/frames">Layouts</a> / {t.name}</nav>
    <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:24px">
      <div>
        <h1 style="font-size:clamp(1.9rem,3.2vw,2.6rem);margin-bottom:6px">{t.name}</h1>
        <p class="muted" style="margin:0;max-width:62ch">{t.description}</p>
      </div>
      <p style="margin:0;font-weight:600">From {formatINR(range.min)}</p>
    </div>
    <FrameCustomizer client:load template={t} whatsapp={site.whatsapp} brandName={site.name} shipping={site.shipping} />
  </section>
  <section class="section section--tint">
    <div class="container prose">
      <h2 style="margin-top:0">Good to know</h2>
      <ul>
        <li>Your photos stay on your device while you design; share the originals on WhatsApp when you order.</li>
        <li>Orders are processed within {site.shipping.processing_days}. For occasions, order {site.shipping.occasion_lead_days} working days ahead.</li>
        <li>Free shipping above ₹{site.shipping.free_above}; a flat ₹{site.shipping.flat_fee} below that.</li>
        <li>Printed colours can differ slightly (about 10–20%) from what you see on screen.</li>
      </ul>
    </div>
  </section>
</Base>
