---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
---

<Base title="Terms of Service" description="Terms of service for ordering personalized photo frames.">
  <section class="section">
    <div class="container prose">
      <h1>Terms of service</h1>
      <h2>Orders</h2>
      <p>
        An order is confirmed once you approve the design preview and payment is received on WhatsApp. The preview
        you approve is the design we print.
      </p>
      <h2>Your content</h2>
      <p>
        You confirm you have the right to use the photos and text you submit. We refuse orders containing unlawful or
        infringing content.
      </p>
      <h2>Incomplete details</h2>
      <p>
        If required personalization details are missing, we follow up on your phone number. If we get no response
        within a reasonable time, the order may be processed with the information we have, or cancelled and refunded.
      </p>
      <h2>Pricing</h2>
      <p>All prices are in Indian Rupees and include the frame. Shipping is as per the <a href="/policies/shipping">shipping policy</a>.</p>
      <h2>Liability</h2>
      <p>
        Our liability for any order is limited to the amount paid for it. Minor colour variation between screen and
        print is expected and not a defect.
      </p>
      <p><em>{site.name}</em></p>
    </div>
  </section>
</Base>
