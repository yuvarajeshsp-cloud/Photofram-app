---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
---

<Base title="Privacy Policy" description="How we handle your photos and personal information.">
  <section class="section">
    <div class="container prose">
      <h1>Privacy policy</h1>
      <h2>Your photos</h2>
      <p>
        While you design a frame, your photos stay in your browser — they are not uploaded to us. When you order, you
        share your photos with us on WhatsApp. We use them only to print your order, and we delete them from our
        devices after the order is delivered and the replacement window has passed.
      </p>
      <h2>Your details</h2>
      <p>
        We collect your name, phone number and delivery address only to process and ship your order. We never sell
        your information.
      </p>
      <h2>Cookies &amp; analytics</h2>
      <p>
        With your consent, we use cookies to measure how our Instagram and Facebook ads perform. Declining consent
        does not affect ordering.
      </p>
      <h2>Contact</h2>
      <p>Questions about privacy? Reach us from the <a href="/contact">contact page</a>.</p>
      <p><em>{site.name}</em></p>
    </div>
  </section>
</Base>
