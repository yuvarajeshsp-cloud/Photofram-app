---
// Website admin, following the Paavai admin pattern: sign in with a normal
// Shop Manager account (Administrator or Manager); edit brand settings, frame
// templates, reviews and FAQs stored in Supabase; Publish rebuilds the site.
import '@rajesh-hub/tokens/web.css';
import '../styles/site.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Site admin</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap" />
  </head>
  <body class="admin-body">
    <div class="admin-wrap">
      <div class="admin-top">
        <h1>Site admin</h1>
      </div>
      <div id="msg" class="admin-msg" role="status" hidden></div>

      <section id="auth" class="admin-card" style="max-width:460px">
        <h2>Sign in</h2>
        <p>Use your Shop Manager account (Administrator or Manager).</p>
        <form id="login-form" style="display:grid;gap:14px">
          <label class="admin-field">Email <input type="email" name="email" autocomplete="username" required /></label>
          <label class="admin-field">Password <input type="password" name="password" autocomplete="current-password" required /></label>
          <div><button class="btn btn--primary" type="submit">Sign in</button></div>
        </form>
      </section>

      <div id="app" hidden>
        <div class="admin-card admin-actions" style="justify-content:space-between">
          <div class="admin-actions">
            <button id="publish" class="btn btn--primary" type="button">Publish website</button>
            <span id="publish-state" class="muted" style="font-size:0.9rem">Changes go live after you publish.</span>
          </div>
          <div class="admin-actions">
            <a class="btn btn--ghost btn--sm" href="/" target="_blank" rel="noopener">View site</a>
            <button id="signout" class="btn btn--ghost btn--sm" type="button">Sign out</button>
          </div>
        </div>

        <section class="admin-card">
          <h2>Brand &amp; shop details</h2>
          <p>Name, logo, colours, WhatsApp number and shipping rules used across the site.</p>
          <form id="settings-form" class="admin-grid">
            <label class="admin-field">Brand name <input name="brand_name" required /></label>
            <label class="admin-field">Tagline <input name="tagline" /></label>
            <label class="admin-field">WhatsApp number (with country code) <input name="whatsapp" inputmode="numeric" placeholder="9198xxxxxxxx" /></label>
            <label class="admin-field">Phone shown on site <input name="phone_display" placeholder="+91 98xxx xxxxx" /></label>
            <label class="admin-field">Instagram handle <input name="instagram" placeholder="yourbrand" /></label>
            <label class="admin-field">Facebook URL <input name="facebook_url" /></label>
            <div class="admin-field admin-field--wide">
              Colours
              <div class="admin-colors">
                <label class="admin-color"><input type="color" name="color_primary" /> Buttons &amp; links</label>
                <label class="admin-color"><input type="color" name="color_primary_hover" /> Button hover</label>
                <label class="admin-color"><input type="color" name="color_tint" /> Soft highlight</label>
                <label class="admin-color"><input type="color" name="color_background" /> Page background</label>
              </div>
            </div>
            <label class="admin-field admin-field--wide">Logo
              <input type="file" name="logo_file" accept="image/*" />
              <span id="logo-now" class="muted" style="font-size:0.85rem"></span>
            </label>
            <label class="admin-field">Announcement bar <input name="announcement" /></label>
            <label class="admin-field">Opening hours <input name="hours" /></label>
            <label class="admin-field">Flat shipping fee (₹) <input name="ship_flat" type="number" min="0" /></label>
            <label class="admin-field">Free shipping above (₹) <input name="ship_free" type="number" min="0" /></label>
            <label class="admin-field">Processing time <input name="ship_processing" placeholder="1-2 business days" /></label>
            <label class="admin-field">Occasion lead time (working days) <input name="ship_lead" type="number" min="1" /></label>
            <label class="admin-field">Address line 1 <input name="addr1" /></label>
            <label class="admin-field">Address line 2 <input name="addr2" /></label>
            <label class="admin-field">City <input name="city" /></label>
            <label class="admin-field">State <input name="state" /></label>
            <label class="admin-field">PIN code <input name="pin" inputmode="numeric" /></label>
            <div class="admin-field--wide admin-actions">
              <button class="btn btn--primary" type="submit">Save details</button>
            </div>
          </form>
        </section>

        <section class="admin-card">
          <h2>Frame templates</h2>
          <p>The layouts customers personalise. Until you add one here, the site shows its built-in starter layouts; “Copy a starter” brings one in so you can change its prices and sizes.</p>
          <div class="admin-actions">
            <button id="tpl-new" class="btn btn--ghost btn--sm" type="button">New template</button>
            <label class="admin-field" style="display:flex;align-items:center;gap:8px">
              <select id="tpl-starter" aria-label="Starter template" style="min-width:220px"></select>
            </label>
            <button id="tpl-copy" class="btn btn--ghost btn--sm" type="button">Copy a starter</button>
          </div>
          <div id="tpl-list" style="margin-top:8px"></div>
        </section>

        <section class="admin-card">
          <h2>Reviews</h2>
          <p>Shown on the home page. Hide a review to keep it without showing it.</p>
          <form id="review-form" class="admin-grid">
            <label class="admin-field">Name <input name="name" required /></label>
            <label class="admin-field">Rating (1–5) <input name="rating" type="number" min="1" max="5" value="5" required /></label>
            <label class="admin-field admin-field--wide">Review <input name="text" required /></label>
            <div class="admin-field--wide admin-actions"><button class="btn btn--ghost btn--sm" type="submit">Add review</button></div>
          </form>
          <div id="review-list" style="margin-top:8px"></div>
        </section>

        <section class="admin-card">
          <h2>FAQs</h2>
          <p>Shown on the FAQs page, in this order.</p>
          <form id="faq-form" class="admin-grid">
            <label class="admin-field admin-field--wide">Question <input name="q" required /></label>
            <label class="admin-field admin-field--wide">Answer <textarea name="a" required style="font-family:inherit;font-size:0.95rem"></textarea></label>
            <div class="admin-field--wide admin-actions"><button class="btn btn--ghost btn--sm" type="submit">Add FAQ</button></div>
          </form>
          <div id="faq-list" style="margin-top:8px"></div>
        </section>
      </div>
    </div>

    <dialog id="tpl-dialog" class="admin-dialog">
      <h2 style="margin-top:0;font-size:1.25rem">Edit template</h2>
      <form id="tpl-form" class="admin-grid" method="dialog">
        <label class="admin-field">Name <input name="name" required /></label>
        <label class="admin-field">Slug (web address) <input name="slug" pattern="[a-z0-9-]+" required /></label>
        <label class="admin-field">Category <input name="category" list="tpl-cats" required /></label>
        <datalist id="tpl-cats"><option value="Collage"></option><option value="Single photo"></option></datalist>
        <label class="admin-field">Catalog image (optional) <input type="file" name="preview_file" accept="image/*" /></label>
        <label class="admin-field admin-field--wide">Description <textarea name="description" style="font-family:inherit;font-size:0.95rem;min-height:70px"></textarea></label>
        <label class="admin-field admin-field--wide">
          Design (JSON): aspect, slots, texts, sizes, finishes, pricing
          <textarea name="json" rows="14" required></textarea>
        </label>
        <div class="admin-field--wide" id="tpl-preview" style="max-width:260px;margin:0 auto"></div>
        <div class="admin-field--wide admin-actions">
          <button class="btn btn--primary" value="save">Save template</button>
          <button class="btn btn--ghost" value="cancel" formnovalidate>Cancel</button>
        </div>
      </form>
    </dialog>

    <script src="../scripts/admin.ts"></script>
  </body>
</html>
