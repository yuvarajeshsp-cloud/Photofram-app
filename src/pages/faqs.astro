---
import Base from '../layouts/Base.astro';
import { content } from '../lib/content';
---

<Base title="FAQs" description="Frequently asked questions about ordering personalized photo frames: shipping, processing time, photo quality and bulk orders.">
  <section class="section">
    <div class="container prose">
      <h1>Frequently asked questions</h1>
      {content.faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
