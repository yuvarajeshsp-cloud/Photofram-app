---
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';
import TemplatePreview from '../components/TemplatePreview.astro';
import { content } from '../lib/content';
import { site } from '../config/site';

const featured = content.templates.slice(0, 3);
const heroTemplates = content.templates.slice(0, 3);
---

<Base title="Personalized Photo Frames" description={`${site.name}: pick a frame template, upload your photos, watch the live preview and order your personalized photo frame.`}>
  <section class="section">
    <div class="container hero">
      <div>
        <p class="hero__eyebrow">Personalized photo frames</p>
        <h1>{site.tagline}</h1>
        <p class="section__intro">
          Pick a frame template, drop your photos into its slots, and watch your frame come to life{' '}
          <strong>instantly</strong> — what you see in the live preview is exactly the layout we print.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/frames">Create your frame</a>
          <a class="btn btn--ghost" href="/how-it-works">How it works</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        {heroTemplates.map((t) => <TemplatePreview template={t} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container center">
      <h2>How it works</h2>
      <p class="section__intro">From template to doorstep in four simple steps.</p>
      <div class="grid grid--4 steps" style="text-align:left">
        <div class="card step"><h3>Choose a template</h3><p>Collages, hearts, single frames — each with ready photo positions.</p></div>
        <div class="card step"><h3>Upload your photos</h3><p>Fill each slot, then drag and zoom every photo until it sits just right.</p></div>
        <div class="card step"><h3>See the live preview</h3><p>Your exact frame — layout, text and finish — rendered as you edit.</p></div>
        <div class="card step"><h3>Order on WhatsApp</h3><p>Send us your design in one tap; we confirm, you pay, we print and ship.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Popular frame templates</h2>
      <p class="section__intro">Start from a design our customers love — every one is fully personalizable.</p>
      <div class="grid grid--3">
        {featured.map((t) => <TemplateCard template={t} />)}
      </div>
      <p style="margin-top:24px"><a class="btn btn--ghost" href="/frames">See all templates</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2>What customers say</h2>
      <div class="grid grid--3">
        {content.reviews.slice(0, 3).map((r) => (
          <div class="card review-card">
            <div class="review-card__stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
            <p>{r.text}</p>
            <strong>{r.name}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <h2>Gifting for a wedding or your team?</h2>
      <p class="section__intro">We take bulk and corporate orders with special pricing, branded packing and doorstep delivery.</p>
      <a class="btn btn--primary" href="/corporate">Corporate &amp; bulk gifts</a>
    </div>
  </section>
</Base>
