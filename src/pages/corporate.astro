---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const wa = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi ${site.name}! I'd like a quote for a bulk / corporate order.`)}`
  : null;
---

<Base title="Corporate & Bulk Gifts" description="Bulk personalized photo frames for weddings, corporate gifting and events, with special pricing and branded packing.">
  <section class="section">
    <div class="container prose">
      <h1>Corporate &amp; bulk gifts</h1>
      <p class="section__intro">
        Personalized frames make memorable gifts for weddings, farewells, annual days and client gifting. We handle
        bulk orders end to end — design, printing, packing and delivery.
      </p>
      <h2>What we offer</h2>
      <ul>
        <li>Special pricing on bulk quantities</li>
        <li>Your logo or event branding on the design and packing</li>
        <li>One design with many names/photos, or fully individual frames</li>
        <li>Gift wrapping and direct delivery to recipients</li>
      </ul>
      <h2>How to start</h2>
      <p>
        Message us on WhatsApp with the occasion, approximate quantity and the date you need delivery by. We'll send
        a quote and sample design within a working day. For occasions, please start at least
        {site.shipping.occasion_lead_days} working days ahead.
      </p>
      {wa && <a class="btn btn--whatsapp" href={wa} rel="noopener">Get a bulk quote on WhatsApp</a>}
    </div>
  </section>
</Base>
