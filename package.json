{
  "name": "photofram-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply photofram --local",
    "db:migrate": "wrangler d1 migrations apply photofram --remote",
    "deploy": "astro build && wrangler deploy",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "npm run admin:build && wrangler dev -c admin/wrangler.jsonc --port 8788 --persist-to .wrangler/state",
    "admin:deploy": "npm run admin:build && wrangler deploy -c admin/wrangler.jsonc",
    "cf-types": "wrangler types -c admin/wrangler.jsonc admin/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@google/model-viewer": "4.4.0",
    "@rajesh-hub/tokens": "*",
    "@rajesh-hub/web-growth": "*",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^7.3.8",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.183.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.167.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "vite": "8.3.8"
    }
  }
}
