# Build-time values (put them in .env locally or in the shell before `npm run deploy`).

# Public site URL (sitemap + canonical links). Defaults to the request's own address.
PUBLIC_SITE_URL=

# Optional marketing: Meta Pixel in the browser. For the Conversions API, also
# set PUBLIC_META_PIXEL_ID as a Worker var and META_CAPI_TOKEN as a Worker secret
# (`npx wrangler secret put META_CAPI_TOKEN`).
PUBLIC_META_PIXEL_ID=
